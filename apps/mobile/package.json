{
  "name": "env-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:android:clean": "expo prebuild --platform android --clean --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit",
    "check:mobile": "npm run typecheck && node scripts/check-mobile.mjs",
    "lint": "expo lint",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
