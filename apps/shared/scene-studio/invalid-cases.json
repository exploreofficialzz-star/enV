          "lookAt": [
            0,
            1,
            0
          ]
        }
      },
      "errors": [
        {
          "code": "camera-degenerate",
          "path": "$.camera"
        }
      ]
    },
    {
      "name": "unknown field only warns",
      "input": {
        "bogus": 1,
        "objects": [
          {
            "id": "a",
