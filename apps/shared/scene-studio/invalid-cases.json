            "id": "a",
            "type": "box"
          }
        ]
      },
      "errors": [
        {
          "code": "duplicate-id",
          "path": "$.objects[1].id"
        }
      ]
    },
    {
      "name": "reserved id",
      "input": {
        "objects": [
          {
            "id": "camera",
