{
  "description": "Every platform must reject these inputs with an error at the given JSON path and code. Warnings are listed separately and must not block.",
  "cases": [
    {
      "name": "not an object",
      "input": [
        1,
        2
      ],
      "errors": [
        {
          "code": "wrong-type",
          "path": "$"
        }
      ]
    },
    {
      "name": "major version too new",
      "input": {
        "version": "2.0"
      },
      "errors": [
        {
          "code": "unsupported-version",
          "path": "$.version"
        }
      ]
    },
    {
      "name": "fps out of range",
      "input": {
        "settings": {
          "fps": 500
        }
      },
      "errors": [
        {
          "code": "out-of-range",
          "path": "$.settings.fps"
        }
      ]
    },
    {
      "name": "duration over limit",
      "input": {
        "settings": {
          "fps": 60,
          "duration": 120.5
        }
      },
      "errors": [
        {
          "code": "out-of-range",
          "path": "$.settings.duration"
        }
      ]
    },
    {
      "name": "maximum frame budget is allowed",
      "input": {
        "version": "1.0",
        "settings": {
          "fps": 60,
          "duration": 120
        }
      },
      "errors": [],
      "warnings": []
    },
    {
      "name": "bad colour",
      "input": {
        "settings": {
          "background": "red"
        }
      },
      "errors": [
        {
          "code": "bad-color",
          "path": "$.settings.background"
        }
      ]
    },
    {
