{
  "version": "1.0",
  "settings": { "width": 1080, "height": 1920, "fps": 30, "duration": 6, "background": "#0b1020" },
  "layers": [
    { "id": "bg", "type": "solid", "plane": "back", "color": "#101a3a" },
    { "id": "badge", "type": "ellipse", "position": [540, 700], "size": [320, 320], "color": "#ffcf33", "opacity": 0 },
    { "id": "title", "type": "text", "position": [540, 1100], "text": "Grand Opening", "font": "display", "fontSize": 120, "color": "#ffffff", "strokeColor": "#d90429", "strokeWidth": 8, "start": 0.5, "end": 6 },
    { "id": "underline", "type": "rect", "position": [540, 1220], "size": [600, 12], "anchor": [0, 0.5], "color": "#d90429", "scale": [0, 1] }
  ],
  "audio": [{ "asset": "library/whoosh_soft", "start": 0.5, "volume": 0.8 }],
  "animations": [
    { "target": "badge", "property": "opacity", "easing": "easeOut", "keyframes": [{ "time": 0, "value": 0 }, { "time": 0.8, "value": 1 }] },
    { "target": "badge", "property": "scale", "easing": "easeOut", "keyframes": [{ "time": 0, "value": 0.2 }, { "time": 0.8, "value": 1 }] },
    { "target": "badge", "property": "rotation", "easing": "easeInOut", "keyframes": [{ "time": 0, "value": -45 }, { "time": 1.2, "value": 0 }] },
    { "target": "title", "property": "position", "easing": "easeOut", "keyframes": [{ "time": 0.5, "value": [540, 1300] }, { "time": 1.3, "value": [540, 1100] }] },
    { "target": "underline", "property": "scale", "easing": "easeInOut", "keyframes": [{ "time": 1.3, "value": [0, 1] }, { "time": 2.2, "value": [1, 1] }] }
  ],
  "captions": { "enabled": false }
}
