{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envtools.store/schemas/a-book-document-v1.schema.json",
  "title": "A book local document export",
  "type": "object",
  "required": [
    "format",
    "exportedAt",
    "notes"
  ],
  "properties": {
    "format": {
      "const": "env.abook.notes.v1"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "notebook",
          "tags",
          "pinned",
          "archived",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "notebook": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pinned": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "deletedAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
