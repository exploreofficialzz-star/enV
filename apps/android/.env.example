# enV application API gateway (serves /api/backend/* and /api/ai/*).
# Do not use the downstream Render media-processor URL as this base.
# Override at build time with: ./gradlew assembleDebug -PENV_API_BASE_URL=https://your-env-app.example
ENV_API_BASE_URL=https://en-v.vercel.app
# Optional server processors are configured on the repository/deployment backend:
OCR_PROCESSOR_URL=
DOCUMENT_PROCESSOR_URL=
WEBSITE_SCREENSHOT_API_URL=
