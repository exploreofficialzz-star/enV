# enV environment template. Copy to .env locally or set these in the Vercel project settings.
# Never commit real values.
VITE_API_BASE_URL=https://env-q3mq.onrender.com
# VITE_ variables are shipped to every browser.
# Run `npm run check:ai` after changing anything in the AI section.

# ---------------------------------------------------------------------------
# AI infrastructure (all optional). With no provider key, AI controls stay
# hidden and every deterministic tool keeps working exactly as before.
# Details: docs/ai-infrastructure.md
# ---------------------------------------------------------------------------

# Provider credentials. Server-side only. Set the providers you actually configure.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Private Modal-hosted MOSS-Music model service; both values are required to enable it.
# MOSS_MUSIC_ENDPOINT is the full HTTPS URL to the protected /analyze endpoint (not the Modal dashboard URL).
MOSS_MUSIC_ENDPOINT=
MOSS_MUSIC_TOKEN=
# GOOGLE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
GOOGLE_AI_API_KEY=

# Master switch. Set to false to turn every AI feature off without touching keys.
AI_ENABLED=true

# Providers that may be used, in preference order (moss_music, groq, openrouter, gemini).
# Cost class decides first; this order breaks ties between equally priced models.
AI_PROVIDER_ORDER=moss_music,groq,openrouter,gemini
# MOSS-Music runs on a dedicated GPU and is STANDARD cost class. Leave LOW to exclude it;
# set STANDARD only after enabling Modal and reviewing the compute cost/credits.

# Highest cost class a model may have: FREE, LOW, STANDARD or PREMIUM.
# LOW is the default. Vision (alt text) needs STANDARD because the vision model is STANDARD class.
AI_MAX_COST_CLASS=LOW

# Set to paid ONLY if billing is enabled on your Gemini project (free-tier content may be used by Google).
AI_GEMINI_TIER=
# Allow privacy-sensitive tasks (images, audio, JSON) on free-tier / may-train models. Default false.
AI_SENSITIVE_ALLOW_FREE_TIER=false

# Spending and volume failsafes (per warm serverless instance, so also set limits at each provider).
# Budget 0 means free models only. When the budget is spent, paid models stop being used.
AI_DAILY_BUDGET_USD=2
AI_DAILY_REQUEST_LIMIT=2000
# Per anonymous session (signed-in users get double). Heavier tasks cost more units.
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=150
# Per IP address per minute: a backstop so clearing cookies does not reset limits. Empty = 5x the session limit.
# Raise it if many of your users share one address (for example carrier-grade NAT on mobile networks).
AI_RATE_LIMIT_PER_IP_PER_MINUTE=

# Comma-separated task ids or prefixes to switch off, e.g. developer.,image.alt.generate
AI_DISABLED_FEATURES=
# Comma-separated provider:model ids to switch off, e.g. groq:openai/gpt-oss-120b
AI_DISABLED_MODELS=

# Require a signed-in user for AI (needs VITE_AUTH_ENABLED=true and the auth setup in the README).
AI_REQUIRE_AUTH=false
# When sign-in is enabled, the AI API asks your own /api/auth/get-session who the caller is.
# It reuses BETTER_AUTH_URL (already required for auth in production); no new variable is needed.

# Result cache for deterministic, non-sensitive tasks (regex and SQL explanations).
AI_CACHE_ENABLED=true

# Development only: include provider/model/latency in API responses and log each attempt.
AI_DEBUG=false

# Enables GET /api/ai/diagnostics (Authorization: Bearer <token>). Use 24+ random characters. Unset = endpoint is off.
AI_ADMIN_TOKEN=
# Signs anonymous session cookies. Set a long random value in production so cookies survive cold starts.
AI_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Backend gateway processors (server-side only; never use a VITE_ prefix).
# Web, Android, and iOS call the public Render API origin. Render proxies application
# /api/* routes and serves heavy media processors without exposing server secrets.
# ---------------------------------------------------------------------------
MEDIA_PROCESSOR_URL=https://env-q3mq.onrender.com/media
URL_MEDIA_PROCESSOR_URL=https://env-q3mq.onrender.com
TRANSCRIBE_URL=
OCR_PROCESSOR_URL=
DOCUMENT_PROCESSOR_URL=
WEBSITE_SCREENSHOT_API_URL=
# Must exactly match the generated PROCESSOR_SHARED_SECRET on the Render processor service.
# Configure it as a server-only variable in Vercel (production and any enabled preview environment); never use a VITE_ prefix.
PROCESSOR_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Monetization and payments. All launch switches remain disabled by default.
# Enable a payment provider only after account-specific merchant approval, finance-approved
# pricing, production auth/Postgres, tested webhooks/refunds/reconciliation, and legal review.
# Native Android/iOS digital token purchases require Play Billing / StoreKit integration;
# do not use web checkout as a native-app billing bypass.
# ---------------------------------------------------------------------------
# These flags must remain false until the production launch checklist is complete.
BILLING_LAUNCH_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# Keep false until refund/dispute event handling, wallet reversal policy, and recovery tests are implemented and approved.
BILLING_REFUND_DISPUTE_HANDLING_APPROVED=false
# Separate server-side token for the aggregate billing/cost-report endpoint (never expose with VITE_).
BILLING_ADMIN_TOKEN=
# Offline token spending is disabled by default. Read-only native Wallet pairing is separate:
# allowance issue/sync remains hard-locked until independent app/device integrity review is complete.
BILLING_OFFLINE_ENABLED=false
BILLING_OFFLINE_PRICING_APPROVED=false
# Local ephemeral PGlite integration tests only; never enable on Vercel or with DATABASE_URL set.
BILLING_OFFLINE_TEST_FINALIZATION=false
# HMAC secret for server-issued allowance tokens; use >=32 cryptographically random bytes, server-side only.
OFFLINE_ALLOWANCE_SIGNING_SECRET=
# Authentication must be enabled and configured before balances/purchases are exposed.
# VITE_AUTH_ENABLED=true
# Payment provider credentials are server-side only. Never use a VITE_ prefix.
PAYSTACK_SECRET_KEY=
# Paystack signs webhook payloads with the same secret key used for API verification.
# Explicit operator gate: true only after Paystack approves enV's token-wallet model and intended channels/markets.
PAYSTACK_PROVIDER_APPROVED=false
# Finance-approved NGN kobo per enV token. Leave empty until finance approval is recorded.
PAYSTACK_TOKEN_PRICE_NGN_KOBO=
# Cryptomus merchant UUID and PAYMENT API key (not the payout API key). Server-side only.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
# Explicit operator gate after Cryptomus onboarding, Nigeria/local-law review, and merchant approval.
CRYPTOMUS_PROVIDER_APPROVED=false
# Finance-approved USD cents per enV token (1 means USD $0.01 per token). Leave empty until approved.
CRYPTOMUS_TOKEN_PRICE_USD_CENTS=
# Referral rewards activate only after a verified qualifying purchase; server-side caps apply.
BILLING_REFERRAL_REWARD_TOKENS=5
BILLING_AFFILIATE_REWARD_PERCENT=10
BILLING_AFFILIATE_REWARD_MAX_TOKENS=100
# Apple and Google purchase verification should use server-side service credentials.
APPLE_APP_BUNDLE_ID=
APPLE_STOREKIT_ISSUER_ID=
APPLE_STOREKIT_KEY_ID=
APPLE_STOREKIT_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=


# ---------------------------------------------------------------------------
# Product analytics (optional, metadata-only, explicit opt-in)
# Keep all signing/admin/cron secrets server-side. Never use a VITE_ prefix.
# See docs/product-analytics-privacy-and-operations.md before enabling.
# ---------------------------------------------------------------------------
ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_RETENTION_DAYS=90
# Public build flag enables the Web consent prompt only; it does not enable collection.
VITE_ANALYTICS_ENABLED=false

# ---------------------------------------------------------------------------
# Developer feedback service (private moderation; public ticket intake is disabled by default).
# Never put FEEDBACK_HASH_SECRET or FEEDBACK_ADMIN_TOKEN in VITE_* values or mobile binaries.
FEEDBACK_ENABLED=false
FEEDBACK_HASH_SECRET=
FEEDBACK_ADMIN_TOKEN=
FEEDBACK_RETENTION_DAYS=365
# Public build flag controls the Web feedback form only; it does not enable the backend.
VITE_FEEDBACK_ENABLED=false

# ---------------------------------------------------------------------------
# Public tool-page community (separate from private developer feedback and analytics).
# Pseudonymous abuse-control signing and moderator credentials are server-only.
COMMUNITY_ENABLED=false
COMMUNITY_HASH_SECRET=
COMMUNITY_ADMIN_TOKEN=
# Public build flag controls the Web tool discussion panel only; it does not enable the backend.
VITE_COMMUNITY_ENABLED=false

# ---------------------------------------------------------------------------
# Product updates / release notes. Admin bearer token is server-only.
UPDATES_ENABLED=false
UPDATES_ADMIN_TOKEN=
# Public build flag enables the Web home banner and /updates page; it does not enable the API.
VITE_UPDATES_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication (optional; leave off until production secrets are configured)
# ---------------------------------------------------------------------------
# Public auth UI switches (VITE_ values are embedded in browser code).
# Only enable a method after the corresponding server credentials are configured and tested.
VITE_AUTH_ENABLED=false
VITE_AUTH_EMAIL_ENABLED=false
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
# Server-side only. Enables verified email/password sign-in, sign-up and recovery.
AUTH_EMAIL_PASSWORD_ENABLED=false
# Canonical HTTPS origin, high-entropy Better Auth secret and durable Postgres.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# Optional standards-based OIDC provider. Set all three values or leave all three empty.
AUTH_OAUTH_ISSUER=
AUTH_OAUTH_CLIENT_ID=
AUTH_OAUTH_CLIENT_SECRET=
# Google web OAuth client (create as a Web application in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple web Sign in with Apple. APPLE_CLIENT_ID is the Apple Services ID.
APPLE_CLIENT_ID=
# Preferred: server generates Apple client-secret JWTs automatically (keep this .p8 key server-side).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional compatibility mode: supply a pre-generated Apple client-secret JWT and rotate it before expiry.
APPLE_CLIENT_SECRET=
# Required for email/password: Resend API key and a verified sender, e.g. enV <auth@your-verified-domain>.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Music Analyzer semantic tagging (server-only; optional).
# Point at a trusted HTTPS service that accepts raw audio bytes and returns JSON.
# See docs/music-analysis-production.md before configuring a production endpoint.
MUSIC_ANALYSIS_ENDPOINT=
MUSIC_ANALYSIS_TOKEN=
